{
  "asOf": "2026-09-24",
  "purpose": "Unit economics for PolySync per athlete-month, by market and schedule-flexibility segment. Every driver cites evidence (product/data/evidence.json) or is an explicit hypothesis with the pilot metric that will replace it.",
  "structure": {
    "note": "B2B2C (ADR-001): the club's own coaches review escalations, so coach time is the club's cost and PolySync's value is coach leverage. A managed variant (PolySync employs the coaches) is modelled separately to answer the software-vs-services question from doc 11.",
    "views": [
      "clubRoi",
      "polysyncSoftwareMargin",
      "managedServiceBreakEven",
      "requiredPenetration"
    ]
  },
