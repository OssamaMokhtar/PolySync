    {
      "id": "UAE",
      "label": "UAE (pilot, ADR-006)",
      "coachBaseHourlyUsd": {
        "formula": "CST-002 AED/month / 173.33 h / CST-004",
        "evidence": [
          "CST-002",
          "CST-004"
        ]
      }
    },
    {
      "id": "US",
      "label": "US (scale, ADR-005)",
      "coachBaseHourlyUsd": {
        "value": 22.67,
        "evidence": [
          "CST-001"
        ]
      }
    }
  ],
