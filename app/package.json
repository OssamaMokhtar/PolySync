{
  "name": "polysync-app",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "NODE_ENV=production node dist/server.cjs",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "eval": "tsx ../evals/run.ts && tsx ../evals/hybrid-run.ts",
    "typecheck:engine": "tsc -p tsconfig.engine.json",
    "typecheck:ratchet": "node scripts/typecheck-ratchet.mjs",
    "check-bundle": "node scripts/check-bundle.mjs",
    "boot-check": "node scripts/boot-check.mjs"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "d3": "^7.9.0",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "firebase": "^12.15.0",
    "jose": "^6.2.12",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "node-fetch": "^2.7.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "recharts": "^3.9.0",
    "uuid": "^14.0.2",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@types/d3": "^7.4.3",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "vitest": "^3.2.7"
  },
  "description": "PolySync — AI-powered personal fitness coach with adaptive workout plans, conversational coaching, wearable integration, and recovery analysis. Built on the PolyVerses multi-agent orchestration architecture.",
  "keywords": [
    "fitness",
    "AI",
    "coach",
    "workout",
    "health",
    "multi-agent",
    "Gemini",
    "adaptive",
    "personal-training"
  ],
  "license": "MIT"
}
